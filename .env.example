PORT=3000
JWT_SECRET=cts_academic_jwt_secret_2007_spec

# MongoDB Connection String (REQUIRED)
# MongoDB is the ONLY persistent database supported by this application.
# The application will NOT start without a valid MONGODB_URI.
# Examples:
#   Local:  mongodb://localhost:27017/central-trade
#   Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/central-trade
MONGODB_URI=mongodb://localhost:27017/central-trade
